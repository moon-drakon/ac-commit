{
  "manifest_version": 3,
  "name": "AC Commit",
  "version": "1.1.0",
  "description": "Every accepted Codeforces, LeetCode, and CodeChef solution becomes a dated commit in your GitHub repo.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": [
    "https://codeforces.com/*",
    "https://leetcode.com/*",
    "https://www.codechef.com/*",
    "https://api.github.com/*"
  ],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://codeforces.com/*", "https://leetcode.com/*", "https://www.codechef.com/*"],
      "js": ["content/agent.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "AC Commit",
    "default_popup": "ui/popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "options_ui": { "page": "ui/options.html", "open_in_tab": true },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
